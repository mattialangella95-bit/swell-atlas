# Copia in .env (che resta fuori da git) e compila.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (Project Settings -> API Keys -> Secret keys, inizia con sb_secret_). Ignora la Row Level
# Security: non va MAI nel repository né nel codice del sito.
SUPABASE_SECRET_KEY=
